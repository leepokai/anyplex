{
  "name": "anyplex",
  "version": "0.1.0",
  "description": "One session interface for hosted agent runtimes: Anthropic Managed Agents, OpenAI Agents API, Gemini Managed Agents. Unified events, provider-reported spend, budget watchdog, stop, and lossless re-attach.",
  "license": "MIT",
  "author": "leepokai",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.30.3",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "e2e": "vitest run test/session.test.ts",
    "e2e:live": "ANYPLEX_LIVE=${ANYPLEX_LIVE:-anthropic,openai,google} vitest run test/live.test.ts test/live-scenarios.test.ts"
  },
  "keywords": [
    "agents",
    "anthropic",
    "managed-agents",
    "openai",
    "agents-api",
    "gemini",
    "interactions",
    "sdk"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.22.0",
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.2.0",
    "hono": "^4.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
